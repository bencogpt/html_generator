{
  "name": "infographic-generator",
  "version": "1.0.0",
  "description": "Offline single-file generator that turns documents (DOCX/TXT/MD) into self-contained interactive HTML infographics via an internal OpenAI-compatible LLM endpoint",
  "private": true,
  "scripts": {
    "build": "node tools/build.js",
    "test": "node tools/test.js",
    "test:proxy": "node tools/proxy-test.js",
    "audit": "node tools/build.js && node tools/audit.js",
    "validate:charts": "node tools/build.js && node tools/validate-charts.js",
    "validate:report": "node tools/build.js && node tools/validate-report.js",
    "validate:diage": "node tools/build.js && node tools/validate-diage.js",
    "cheatsheet": "node tools/build.js && node tools/make-cheatsheet.js",
    "userguide": "node tools/build.js && node tools/make-userguide.js",
    "e2e": "node tools/build.js && node tools/e2e.js",
    "screenshots": "node tools/screenshots.js",
    "proxy": "node tools/cors-proxy.js",
    "pipeline-doc": "node tools/make-pipeline-doc.js"
  },
  "license": "MIT",
  "dependencies": {
    "chart.js": "4.4.0",
    "chartjs-chart-geo": "^4.3.4",
    "chartjs-chart-matrix": "^2.0.1",
    "mammoth": "1.8.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
