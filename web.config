<?xml version="1.0" encoding="utf-8"?>
<!--
  NOIZZ — IIS configuration
  Place this file (together with noizz.html and data.ashx) in the IIS
  site/application folder. See DEPLOY-IIS.md for full setup steps.
-->
<configuration>
  <system.web>
    <!-- .NET Framework 4.x is built into Windows Server; no extra runtime needed.
         maxRequestLength is in KB (10 MB here) to allow large datasets. -->
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" requestValidationMode="2.0" />
    <compilation targetFramework="4.8" debug="false" />
    <customErrors mode="RemoteOnly" />
  </system.web>

  <system.webServer>
    <!-- Open noizz.html by default when the site root is requested. -->
    <defaultDocument>
      <files>
        <clear />
        <add value="noizz.html" />
      </files>
    </defaultDocument>

    <!-- WebDAV intercepts PUT and would return 405; remove it so the
         data.ashx handler can accept PUT requests. -->
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <!-- 10 MB request ceiling, matching maxRequestLength above. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

    <!-- Serve the JSON backup MIME type correctly if browsed directly. -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
